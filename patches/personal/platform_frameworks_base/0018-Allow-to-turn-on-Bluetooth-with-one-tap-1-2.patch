From c1739acf5c275d03e4d6a32c9f82d8157ef2d007 Mon Sep 17 00:00:00 2001
From: ChonDoit <thphantomblog@gmail.com>
Date: Tue, 17 Sep 2024 00:38:44 -0300
Subject: [PATCH 18/31] Allow to turn on Bluetooth with one-tap [1/2]

---
 core/java/android/provider/Settings.java      |  6 +++++
 .../systemui/qs/tiles/BluetoothTile.java      | 25 +++++++++++++++++--
 2 files changed, 29 insertions(+), 2 deletions(-)

diff --git a/core/java/android/provider/Settings.java b/core/java/android/provider/Settings.java
index 3a96c820..3988afe2 100644
--- a/core/java/android/provider/Settings.java
+++ b/core/java/android/provider/Settings.java
@@ -6770,6 +6770,12 @@ public final class Settings {
         @Readable
         public static final String ENABLE_FLOATING_ROTATION_BUTTON = "enable_floating_rotation_button";
 
+	/**
+         * Whether to turn on Bluetooth wirh only One-Tap
+         * @hide
+         */
+        public static final String QS_BT_ONE_TAP = "qs_bt_one_tap";
+
         /**
          * Keys we no longer back up under the current schema, but want to continue to
          * process when restoring historical backup datasets.
diff --git a/packages/SystemUI/src/com/android/systemui/qs/tiles/BluetoothTile.java b/packages/SystemUI/src/com/android/systemui/qs/tiles/BluetoothTile.java
index 18d2f306..fed889d8 100644
--- a/packages/SystemUI/src/com/android/systemui/qs/tiles/BluetoothTile.java
+++ b/packages/SystemUI/src/com/android/systemui/qs/tiles/BluetoothTile.java
@@ -22,6 +22,7 @@ import android.annotation.Nullable;
 import android.bluetooth.BluetoothAdapter;
 import android.bluetooth.BluetoothClass;
 import android.bluetooth.BluetoothDevice;
+import android.content.Context;
 import android.content.Intent;
 import android.os.Handler;
 import android.os.HandlerExecutor;
@@ -79,6 +80,8 @@ public class BluetoothTile extends QSTileImpl<BooleanState> {
 
     private final FeatureFlags mFeatureFlags;
 
+    private boolean oneTap;
+
     @Inject
     public BluetoothTile(
             QSHost host,
@@ -108,9 +111,15 @@ public class BluetoothTile extends QSTileImpl<BooleanState> {
         return new BooleanState();
     }
 
+    public boolean oneTap() {
+        return Settings.System.getInt(mContext.getContentResolver(),
+                Settings.System.QS_BT_ONE_TAP, 0) == 1;
+    }
+
     @Override
     protected void handleClick(@Nullable View view) {
-        if (mFeatureFlags.isEnabled(Flags.BLUETOOTH_QS_TILE_DIALOG)) {
+        boolean isOneTap = oneTap();
+        if (mFeatureFlags.isEnabled(Flags.BLUETOOTH_QS_TILE_DIALOG) && !isOneTap) {
             mDialogViewModel.showDialog(mContext, view);
         } else {
             // Secondary clicks are header clicks, just toggle.
@@ -121,9 +130,21 @@ public class BluetoothTile extends QSTileImpl<BooleanState> {
         }
     }
 
+    @Override
+    protected void handleLongClick(@Nullable View view) {
+        boolean isOneTap = oneTap();
+        if (isOneTap) {
+            mDialogViewModel.showDialog(mContext, view);
+        } else {
+            mActivityStarter.postStartActivityDismissingKeyguard(
+                    new Intent(Settings.ACTION_BLUETOOTH_SETTINGS), 0);
+            return;
+        }
+    }
+
     @Override
     public Intent getLongClickIntent() {
-        return new Intent(Settings.ACTION_BLUETOOTH_SETTINGS);
+        return null;
     }
 
     @Override
-- 
2.47.0

