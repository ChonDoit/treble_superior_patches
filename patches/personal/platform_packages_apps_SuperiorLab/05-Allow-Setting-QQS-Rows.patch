From 141e6b7dfb758c21cd43a8f66f3abc76a0c1a4a4 Mon Sep 17 00:00:00 2001
From: ChonDoit <thphantomblog@gmail.com>
Date: Sat, 23 Mar 2024 18:00:24 -0300
Subject: [PATCH 5/7] Allow Setting QQS Rows

---
 res/values/superior_strings.xml        |  4 ++++
 res/xml/superior_lab_quicksettings.xml | 16 ++++++++++++++++
 2 files changed, 20 insertions(+)

diff --git a/res/values/superior_strings.xml b/res/values/superior_strings.xml
index 76111d7..c2964a7 100644
--- a/res/values/superior_strings.xml
+++ b/res/values/superior_strings.xml
@@ -463,4 +463,8 @@
     <string name="qs_tile_ui_style_a11_square">Android 11 (Rounded Rectangle)</string>
     <string name="qs_tile_ui_style_a11_mix">Android 11 (Squircle Mix)</string>
 
+    <!-- QQS Rows -->
+    <string name="qqs_rows_portrait_title">Quick QS Rows (portrait)</string>
+    <string name="qqs_rows_landscape_title">Quick QS Rows (landscape)</string>
+
 </resources>
diff --git a/res/xml/superior_lab_quicksettings.xml b/res/xml/superior_lab_quicksettings.xml
index bb457b8..ed43acd 100644
--- a/res/xml/superior_lab_quicksettings.xml
+++ b/res/xml/superior_lab_quicksettings.xml
@@ -124,6 +124,22 @@
          settings:interval="1"
          android:defaultValue="4" />
 
+    <com.superior.support.preferences.SystemSettingSeekBarPreference
+         android:key="qqs_layout_rows"
+         android:title="@string/qqs_rows_portrait_title"
+         android:max="2"
+         settings:min="1"
+         settings:interval="1"
+         android:defaultValue="2" />
+
+    <com.superior.support.preferences.SystemSettingSeekBarPreference
+         android:key="qqs_layout_rows_landscape"
+         android:title="@string/qqs_rows_landscape_title"
+         android:max="2"
+         settings:min="1"
+         settings:interval="1"
+         android:defaultValue="2" />
+
     </PreferenceCategory>
 
 </PreferenceScreen>
-- 
2.46.0

