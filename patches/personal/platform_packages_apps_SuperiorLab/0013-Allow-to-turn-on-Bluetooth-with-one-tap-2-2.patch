From 2599c7fb8991539ecc39afd219beeefe617b375f Mon Sep 17 00:00:00 2001
From: ChonDoit <thphantomblog@gmail.com>
Date: Tue, 17 Sep 2024 00:47:44 -0300
Subject: [PATCH 13/14] Allow to turn on Bluetooth with one-tap [2/2]

---
 res/values/custom_strings.xml          | 4 ++++
 res/xml/superior_lab_quicksettings.xml | 6 ++++++
 2 files changed, 10 insertions(+)

diff --git a/res/values/custom_strings.xml b/res/values/custom_strings.xml
index 06de747..d4a61d0 100644
--- a/res/values/custom_strings.xml
+++ b/res/values/custom_strings.xml
@@ -124,4 +124,8 @@
     <string name="monet_engine_tint_background_title">Tint background</string>
     <string name="monet_engine_tint_background_summary">Make luminance and chroma selection affect background colors as well</string>
 
+    <!-- Bluetooth Dialog -->
+    <string name="qs_bluetooth_one_tap_title">One-Tap Bluetooth</string>
+    <string name="qs_bluetooth_one_tap_summary">Enable bluetooth with only one-tap (Long-tap to open dialog)</string>
+
 </resources>
diff --git a/res/xml/superior_lab_quicksettings.xml b/res/xml/superior_lab_quicksettings.xml
index 919df05..a4fd86e 100644
--- a/res/xml/superior_lab_quicksettings.xml
+++ b/res/xml/superior_lab_quicksettings.xml
@@ -18,6 +18,12 @@
             android:entryValues="@array/quick_pulldown_values"
             android:defaultValue="0" />
 
+        <com.superior.support.preferences.SystemSettingSwitchPreference
+            android:key="qs_bt_one_tap"
+            android:title="@string/qs_bluetooth_one_tap_title"
+            android:summary="@string/qs_bluetooth_one_tap_summary"
+            android:defaultValue="false" />
+
         <com.superior.support.preferences.SecureSettingSwitchPreference
             android:key="quick_settings_vibrate"
             android:title="@string/quick_settings_vibrate_title"
-- 
2.47.0

