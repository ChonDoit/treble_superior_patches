From 4d8db972497cde5dabee9fec4ac3b177510d1fc6 Mon Sep 17 00:00:00 2001
From: ChonDoit <thphantomblog@gmail.com>
Date: Thu, 21 Nov 2024 21:55:47 -0300
Subject: [PATCH 2/2] QS Background features

---
 res/values/custom_strings.xml          |  8 ++++++++
 res/xml/superior_lab_quicksettings.xml | 16 ++++++++++++++++
 2 files changed, 24 insertions(+)

diff --git a/res/values/custom_strings.xml b/res/values/custom_strings.xml
index d4a61d0..ba713ce 100644
--- a/res/values/custom_strings.xml
+++ b/res/values/custom_strings.xml
@@ -128,4 +128,12 @@
     <string name="qs_bluetooth_one_tap_title">One-Tap Bluetooth</string>
     <string name="qs_bluetooth_one_tap_summary">Enable bluetooth with only one-tap (Long-tap to open dialog)</string>
 
+    <!-- QS Transparency -->
+    <string name="qs_transparency_title">Background transparency</string>
+    <string name="qs_transparency_summary">Set transparency level for QS background</string>
+
+    <!-- QS Dual Tone Colors -->
+    <string name="qs_dual_tone_title">Dual tone background</string>
+    <string name="qs_dual_tone_summary">Enable dual tone background colors</string>
+
 </resources>
diff --git a/res/xml/superior_lab_quicksettings.xml b/res/xml/superior_lab_quicksettings.xml
index 97b6064..563fd83 100644
--- a/res/xml/superior_lab_quicksettings.xml
+++ b/res/xml/superior_lab_quicksettings.xml
@@ -79,6 +79,22 @@
             android:title="@string/qs_header_title"
             android:fragment="com.superior.lab.fragments.QsHeaderImageSettings" />
 
+	<com.superior.support.preferences.SystemSettingSeekBarPreference
+            android:key="qs_transparency"
+            android:title="@string/qs_transparency_title"
+            android:summary="@string/qs_transparency_summary"
+            android:defaultValue="100"
+            settings:interval="1"
+            settings:units="%"
+            android:max="100"
+            android:min="1" />
+
+	<com.superior.support.preferences.SystemSettingSwitchPreference
+	    android:key="qs_dual_tone"
+	    android:title="@string/qs_dual_tone_title"
+	    android:summary="@string/qs_dual_tone_summary"
+	    android:defaultValue="false" />
+
     </PreferenceCategory>
 
     <PreferenceCategory
-- 
